{
  "name": "EM OS: your personal operating system",
  "short_name": "EM OS",
  "description": "Daily check-ins, habits, goals and streaks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d1117",
